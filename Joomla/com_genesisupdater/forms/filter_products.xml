<?xml version="1.0" encoding="UTF-8"?>
<form>
	<fields name="filter">
		<field
			name="search"
			type="text"
			label="JSEARCH_FILTER_LABEL"
			hint="JSEARCH_FILTER"
		/>
		<field
			name="type"
			type="list"
			label="COM_GENESISUPDATER_FIELD_TYPE_LABEL"
			onchange="this.form.submit();"
		>
			<option value="">JOPTION_SELECT_TYPE</option>
			<option value="template">COM_GENESISUPDATER_TYPE_TEMPLATE</option>
			<option value="component">COM_GENESISUPDATER_TYPE_COMPONENT</option>
			<option value="module">COM_GENESISUPDATER_TYPE_MODULE</option>
			<option value="plugin">COM_GENESISUPDATER_TYPE_PLUGIN</option>
			<option value="library">COM_GENESISUPDATER_TYPE_LIBRARY</option>
			<option value="package">COM_GENESISUPDATER_TYPE_PACKAGE</option>
			<option value="file">COM_GENESISUPDATER_TYPE_FILE</option>
			<option value="language">COM_GENESISUPDATER_TYPE_LANGUAGE</option>
		</field>
		<field
			name="platform"
			type="list"
			label="COM_GENESISUPDATER_FIELD_VERSION_PLATFORM_LABEL"
			onchange="this.form.submit();"
		>
			<option value="">COM_GENESISUPDATER_SELECT_PLATFORM</option>
			<option value="joomla">COM_GENESISUPDATER_PLATFORM_JOOMLA</option>
			<option value="wordpress">COM_GENESISUPDATER_PLATFORM_WORDPRESS</option>
			<option value="mobile">COM_GENESISUPDATER_PLATFORM_MOBILE</option>
			<option value="fab">COM_GENESISUPDATER_PLATFORM_FAB</option>
		</field>
		<field
			name="published"
			type="status"
			label="JOPTION_SELECT_PUBLISHED"
			onchange="this.form.submit();"
		>
			<option value="">JOPTION_SELECT_PUBLISHED</option>
			<option value="*">JALL</option>
		</field>
	</fields>
	<fields name="list">
		<field
			name="fullordering"
			type="list"
			label="JGLOBAL_SORT_BY"
			default="a.title ASC"
			onchange="this.form.submit();"
		>
			<option value="">JGLOBAL_SORT_BY</option>
			<option value="a.title ASC">JGLOBAL_TITLE_ASC</option>
			<option value="a.title DESC">JGLOBAL_TITLE_DESC</option>
			<option value="a.element ASC">COM_GENESISUPDATER_FIELD_ELEMENT_LABEL_ASC</option>
			<option value="a.element DESC">COM_GENESISUPDATER_FIELD_ELEMENT_LABEL_DESC</option>
			<option value="a.state ASC">JSTATUS_ASC</option>
			<option value="a.state DESC">JSTATUS_DESC</option>
			<option value="a.id ASC">JGRID_HEADING_ID_ASC</option>
			<option value="a.id DESC">JGRID_HEADING_ID_DESC</option>
		</field>
		<field
			name="limit"
			type="limitbox"
			label="JGLOBAL_LIST_LIMIT"
			default="25"
			onchange="this.form.submit();"
		/>
	</fields>
</form>
