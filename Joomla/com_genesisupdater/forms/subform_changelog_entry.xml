<?xml version="1.0" encoding="UTF-8"?>
<form>
	<fieldset name="entry">
		<field
			name="version"
			type="text"
			label="COM_GENESISUPDATER_FIELD_ENTRY_VERSION_LABEL"
			required="true"
			size="10"
		/>
		<field
			name="date"
			type="calendar"
			label="COM_GENESISUPDATER_FIELD_ENTRY_RELEASE_DATE_LABEL"
			format="%Y-%m-%d"
			filter="user_utc"
		/>
		<field
			name="category"
			type="list"
			label="COM_GENESISUPDATER_FIELD_ENTRY_CATEGORY_LABEL"
			default="change"
		>
			<option value="addition">COM_GENESISUPDATER_CATEGORY_ADDITION</option>
			<option value="change">COM_GENESISUPDATER_CATEGORY_CHANGE</option>
			<option value="fix">COM_GENESISUPDATER_CATEGORY_FIX</option>
			<option value="remove">COM_GENESISUPDATER_CATEGORY_REMOVE</option>
			<option value="security">COM_GENESISUPDATER_CATEGORY_SECURITY</option>
			<option value="deprecated">COM_GENESISUPDATER_CATEGORY_DEPRECATED</option>
			<option value="language">COM_GENESISUPDATER_CATEGORY_LANGUAGE</option>
			<option value="note">COM_GENESISUPDATER_CATEGORY_NOTE</option>
		</field>
		<field
			name="items"
			type="textarea"
			label="COM_GENESISUPDATER_FIELD_ENTRY_ITEMS_LABEL"
			description="COM_GENESISUPDATER_FIELD_ENTRY_ITEMS_DESC"
			rows="4"
			cols="50"
		/>
	</fieldset>
</form>
