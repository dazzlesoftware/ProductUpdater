<?xml version="1.0" encoding="UTF-8"?>
<form addfieldprefix="Joomla\Component\Genesisupdater\Administrator\Field">
	<fieldset name="details">
		<field
			name="id"
			type="number"
			label="JGLOBAL_FIELD_ID_LABEL"
			default="0"
			class="readonly"
			readonly="true"
		/>
		<field
			name="title"
			type="text"
			label="COM_GENESISUPDATER_FIELD_TITLE_LABEL"
			required="true"
			size="40"
		/>
		<field
			name="element"
			type="text"
			label="COM_GENESISUPDATER_FIELD_ELEMENT_LABEL"
			description="COM_GENESISUPDATER_FIELD_ELEMENT_DESC"
			required="true"
			size="40"
			hint="tpl_helium"
		/>
		<field
			name="platform"
			type="list"
			label="COM_GENESISUPDATER_FIELD_VERSION_PLATFORM_LABEL"
			default="joomla"
			required="true"
		>
			<option value="joomla">COM_GENESISUPDATER_PLATFORM_JOOMLA</option>
			<option value="wordpress">COM_GENESISUPDATER_PLATFORM_WORDPRESS</option>
			<option value="mobile">COM_GENESISUPDATER_PLATFORM_MOBILE</option>
			<option value="fab">COM_GENESISUPDATER_PLATFORM_FAB</option>
		</field>
		<field
			name="type"
			type="list"
			label="COM_GENESISUPDATER_FIELD_TYPE_LABEL"
			default="component"
			required="true"
		>
			<option value="template" class="type-joomla">COM_GENESISUPDATER_TYPE_TEMPLATE</option>
			<option value="component" class="type-joomla">COM_GENESISUPDATER_TYPE_COMPONENT</option>
			<option value="module" class="type-joomla">COM_GENESISUPDATER_TYPE_MODULE</option>
			<option value="plugin" class="type-joomla">COM_GENESISUPDATER_TYPE_PLUGIN</option>
			<option value="library" class="type-joomla">COM_GENESISUPDATER_TYPE_LIBRARY</option>
			<option value="package" class="type-joomla">COM_GENESISUPDATER_TYPE_PACKAGE</option>
			<option value="file" class="type-joomla">COM_GENESISUPDATER_TYPE_FILE</option>
			<option value="language" class="type-joomla">COM_GENESISUPDATER_TYPE_LANGUAGE</option>
			<option value="wordpress-plugin" class="type-wordpress">COM_GENESISUPDATER_TYPE_WORDPRESS_PLUGIN</option>
			<option value="wordpress-theme" class="type-wordpress">COM_GENESISUPDATER_TYPE_WORDPRESS_THEME</option>
			<option value="mobile-app" class="type-mobile">COM_GENESISUPDATER_TYPE_MOBILE_APP</option>
			<option value="fab-2d-assets" class="type-fab">COM_GENESISUPDATER_TYPE_FAB_2D_ASSETS</option>
			<option value="fab-3d-models" class="type-fab">COM_GENESISUPDATER_TYPE_FAB_3D_MODELS</option>
			<option value="fab-animations" class="type-fab">COM_GENESISUPDATER_TYPE_FAB_ANIMATIONS</option>
			<option value="fab-audio" class="type-fab">COM_GENESISUPDATER_TYPE_FAB_AUDIO</option>
			<option value="fab-environments" class="type-fab">COM_GENESISUPDATER_TYPE_FAB_ENVIRONMENTS</option>
			<option value="fab-game-templates" class="type-fab">COM_GENESISUPDATER_TYPE_FAB_GAME_TEMPLATES</option>
			<option value="fab-tools-plugins" class="type-fab">COM_GENESISUPDATER_TYPE_FAB_TOOLS_PLUGINS</option>
			<option value="fab-ui" class="type-fab">COM_GENESISUPDATER_TYPE_FAB_UI</option>
			<option value="custom" class="type-all">COM_GENESISUPDATER_TYPE_CUSTOM</option>
		</field>
		<field
			name="description"
			type="textarea"
			label="COM_GENESISUPDATER_FIELD_DESCRIPTION_LABEL"
			rows="4"
			cols="50"
		/>
		<field name="preview_image" type="media" label="COM_GENESISUPDATER_FIELD_PREVIEW_IMAGE_LABEL" description="COM_GENESISUPDATER_FIELD_PREVIEW_IMAGE_DESC" preview="tooltip" types="images" />
		<field
			name="maintainer"
			type="text"
			label="COM_GENESISUPDATER_FIELD_MAINTAINER_LABEL"
			size="40"
		/>
		<field
			name="maintainer_url"
			type="url"
			label="COM_GENESISUPDATER_FIELD_MAINTAINER_URL_LABEL"
			size="40"
		/>
		<field
			name="catid"
			type="category"
			extension="com_genesisupdater"
			label="COM_GENESISUPDATER_FIELD_DOWNLOAD_CATEGORY_LABEL"
			description="COM_GENESISUPDATER_FIELD_DOWNLOAD_CATEGORY_DESC"
			default="0"
			published="0,1"
		/>
		<field
			name="download_count"
			type="number"
			label="COM_GENESISUPDATER_FIELD_DOWNLOAD_COUNT_LABEL"
			description="COM_GENESISUPDATER_FIELD_DOWNLOAD_COUNT_DESC"
			default="0"
			min="0"
			step="1"
		/>
		<field
			name="state"
			type="list"
			label="JSTATUS"
			default="1"
			filter="intval"
		>
			<option value="1">JPUBLISHED</option>
			<option value="0">JUNPUBLISHED</option>
			<option value="2">JARCHIVED</option>
			<option value="-2">JTRASHED</option>
		</field>
		<field
			name="ordering"
			type="text"
			label="COM_GENESISUPDATER_FIELD_ORDERING_LABEL"
			default="0"
		/>
	</fieldset>
	<fieldset name="versions" label="COM_GENESISUPDATER_FIELDSET_VERSIONS">
		<field
			name="versions"
			type="subform"
			label="COM_GENESISUPDATER_FIELD_VERSIONS_LABEL"
			description="COM_GENESISUPDATER_FIELD_VERSIONS_DESC"
			multiple="true"
			layout="joomla.form.field.subform.repeatable-table"
			formsource="administrator/components/com_genesisupdater/forms/subform_version.xml"
			min="0"
		/>
	</fieldset>
</form>
