<?xml version="1.0" encoding="UTF-8"?>
<form>
 <fieldset name="details">
  <field name="id" type="number" label="JGLOBAL_FIELD_ID_LABEL" default="0" readonly="true" class="readonly"/>
  <field name="title" type="text" label="COM_GENESISPRODUCTUPDATER_FIELD_TITLE_LABEL" required="true"/>
  <field name="description" type="text" label="COM_GENESISPRODUCTUPDATER_FIELD_DESCRIPTION_LABEL"/>
  <field name="platform" type="list" label="COM_GENESISPRODUCTUPDATER_FIELD_PLATFORM_LABEL" default="joomla" required="true"><option value="joomla">Joomla</option><option value="wordpress">WordPress</option><option value="mobile">Mobile</option><option value="fab">Fab</option></field>
  <field name="output_slug" type="text" label="COM_GENESISPRODUCTUPDATER_FIELD_BUNDLE_OUTPUT_SLUG_LABEL" description="COM_GENESISPRODUCTUPDATER_FIELD_BUNDLE_OUTPUT_SLUG_DESC" hint="gantry-5"/>
  <field name="filename" type="text" label="COM_GENESISPRODUCTUPDATER_FIELD_BUNDLE_FILENAME_LABEL" default="list.xml" required="true"/>
  <field name="product_ids" type="sql" label="COM_GENESISPRODUCTUPDATER_FIELD_BUNDLE_PRODUCTS_LABEL" description="COM_GENESISPRODUCTUPDATER_FIELD_BUNDLE_PRODUCTS_DESC" multiple="true" size="12" query="SELECT id AS value, CONCAT(title, ' [', platform, '] (', element, ')') AS text FROM #__productupdater_products WHERE state IN (0,1) ORDER BY platform, title ASC" key_field="value" value_field="text"/>
  <field name="state" type="list" label="JSTATUS" default="1" filter="intval"><option value="1">JPUBLISHED</option><option value="0">JUNPUBLISHED</option><option value="2">JARCHIVED</option><option value="-2">JTRASHED</option></field>
  <field name="ordering" type="number" label="COM_GENESISPRODUCTUPDATER_FIELD_ORDERING_LABEL" default="0"/>
 </fieldset>
</form>
