<?xml version="1.0" encoding="UTF-8"?>
<form addfieldprefix="Joomla\Component\Genesisproductupdater\Administrator\Field">
	<fieldset name="version">
		<field
			name="version"
			type="text"
			label="COM_GENESISPRODUCTUPDATER_FIELD_VERSION_VERSION_LABEL"
			required="true"
			size="10"
			hint="1.0.0"
		/>
		<field
			name="target_version"
			type="text"
			label="COM_GENESISPRODUCTUPDATER_FIELD_VERSION_TARGET_VERSION_LABEL"
			description="COM_GENESISPRODUCTUPDATER_FIELD_VERSION_TARGET_VERSION_DESC"
			size="10"
			hint="5.0"
		/>
		<field
			name="tag"
			type="list"
			label="COM_GENESISPRODUCTUPDATER_FIELD_VERSION_TAG_LABEL"
			default="stable"
		>
			<option value="stable">COM_GENESISPRODUCTUPDATER_TAG_STABLE</option>
			<option value="beta">COM_GENESISPRODUCTUPDATER_TAG_BETA</option>
			<option value="rc">COM_GENESISPRODUCTUPDATER_TAG_RC</option>
			<option value="dev">COM_GENESISPRODUCTUPDATER_TAG_DEV</option>
		</field>
		<field
			name="is_current"
			type="radio"
			layout="joomla.form.field.radio.switcher"
			label="COM_GENESISPRODUCTUPDATER_FIELD_VERSION_IS_CURRENT_LABEL"
			default="0"
		>
			<option value="0">JNO</option>
			<option value="1">JYES</option>
		</field>
		<field
			name="download_url"
			type="url"
			label="COM_GENESISPRODUCTUPDATER_FIELD_VERSION_DOWNLOAD_URL_LABEL"
			size="60"
		/>
		<field
			name="sha512"
			type="text"
			label="COM_GENESISPRODUCTUPDATER_FIELD_VERSION_SHA512_LABEL"
			size="60"
		/>
		<field
			name="info_url"
			type="url"
			label="COM_GENESISPRODUCTUPDATER_FIELD_VERSION_INFO_URL_LABEL"
			size="60"
		/>
		<field
			name="info_title"
			type="text"
			label="COM_GENESISPRODUCTUPDATER_FIELD_VERSION_INFO_TITLE_LABEL"
			size="30"
		/>
		<field
			name="changelog_mode"
			type="list"
			label="COM_GENESISPRODUCTUPDATER_FIELD_VERSION_CHANGELOG_MODE_LABEL"
			default="generated"
		>
			<option value="generated">COM_GENESISPRODUCTUPDATER_CHANGELOG_MODE_GENERATED</option>
			<option value="custom">COM_GENESISPRODUCTUPDATER_CHANGELOG_MODE_CUSTOM</option>
			<option value="none">COM_GENESISPRODUCTUPDATER_CHANGELOG_MODE_NONE</option>
		</field>
		<field
			name="changelog_url"
			type="url"
			label="COM_GENESISPRODUCTUPDATER_FIELD_VERSION_CHANGELOG_URL_LABEL"
			size="60"
			showon="changelog_mode:custom"
		/>
		<field
			name="release_date"
			type="calendar"
			label="COM_GENESISPRODUCTUPDATER_FIELD_VERSION_RELEASE_DATE_LABEL"
			format="%Y-%m-%d"
			filter="user_utc"
		/>
		<field
			name="requires"
			type="text"
			label="COM_GENESISPRODUCTUPDATER_FIELD_VERSION_REQUIRES_LABEL"
			description="COM_GENESISPRODUCTUPDATER_FIELD_VERSION_REQUIRES_DESC"
			size="10"
		/>
		<field
			name="tested"
			type="text"
			label="COM_GENESISPRODUCTUPDATER_FIELD_VERSION_TESTED_LABEL"
			description="COM_GENESISPRODUCTUPDATER_FIELD_VERSION_TESTED_DESC"
			size="10"
		/>
		<field
			name="requires_php"
			type="text"
			label="COM_GENESISPRODUCTUPDATER_FIELD_VERSION_REQUIRES_PHP_LABEL"
			size="10"
			hint="8.1"
		/>
		<field
			name="build_number"
			type="text"
			label="COM_GENESISPRODUCTUPDATER_FIELD_VERSION_BUILD_NUMBER_LABEL"
			description="COM_GENESISPRODUCTUPDATER_FIELD_VERSION_BUILD_NUMBER_DESC"
			size="10"
		/>
		<field
			name="url_ios"
			type="url"
			label="COM_GENESISPRODUCTUPDATER_FIELD_VERSION_URL_IOS_LABEL"
			size="60"
		/>
		<field
			name="url_android"
			type="url"
			label="COM_GENESISPRODUCTUPDATER_FIELD_VERSION_URL_ANDROID_LABEL"
			size="60"
		/>
		<field name="url_fab" type="url" label="COM_GENESISPRODUCTUPDATER_FIELD_VERSION_URL_FAB_LABEL" size="60" />
		<field
			name="force_update"
			type="radio"
			layout="joomla.form.field.radio.switcher"
			label="COM_GENESISPRODUCTUPDATER_FIELD_VERSION_FORCE_UPDATE_LABEL"
			default="0"
		>
			<option value="0">JNO</option>
			<option value="1">JYES</option>
		</field>
		<field
			name="release_notes"
			type="textarea"
			label="COM_GENESISPRODUCTUPDATER_FIELD_VERSION_RELEASE_NOTES_LABEL"
			rows="3"
			cols="40"
		/>
	</fieldset>
</form>
